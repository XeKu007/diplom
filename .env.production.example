# ============================================================
# PRODUCTION ENVIRONMENT VARIABLES
# Энэ файлыг .env.production болгон хуулж, утгуудыг өөрчилнө.
# АНХААРУУЛГА: .env.production файлыг git-д commit хийхгүй!
# ============================================================

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string (Vercel Postgres, Supabase, Neon, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/indra_cyber?sslmode=require"

# ── JWT Secret ───────────────────────────────────────────────
# Хамгийн багадаа 32 тэмдэгт, санамсаргүй string ашиглана уу
# Үүсгэх: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="CHANGE_THIS_TO_A_RANDOM_64_CHARACTER_STRING"

# ── App URL ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
NODE_ENV="production"

# ── Optional: Email (мэдэгдэл илгээхэд) ─────────────────────
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="noreply@indra-cyber.edu.mn"
